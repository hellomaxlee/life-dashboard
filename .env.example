HOME_TZ=America/New_York
# Optional. Empty = no auth check on POST /ingest/health (LAN only). Set it and Health Auto Export
# must send "Authorization: Bearer <token>" or "X-Api-Key: <token>".
HEALTH_EXPORT_TOKEN=
# Optional. The `read` shelf's old RSS link (https://www.goodreads.com/review/list_rss/<user id>?shelf=read).
# Goodreads retired the feed itself (2026-10-28); the poll takes the user id and shelf from this
# link and reads the public shelf widget. A key in the link is never sent. Empty = no goodreads_poll job and `tools.sync --source goodreads` says so.
GOODREADS_RSS_URL=
ANTHROPIC_API_KEY=
SUMMARY_MONTHLY_CAP_USD=3
