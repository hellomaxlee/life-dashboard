HOME_TZ=America/New_York
# Optional. Empty = no auth check on POST /ingest/health (LAN only). Set it and Health Auto Export
# must send "Authorization: Bearer <token>" or "X-Api-Key: <token>".
HEALTH_EXPORT_TOKEN=
# Optional. The `read` shelf's RSS link (Goodreads → My Books → read → RSS icon); it carries a
# private key. Empty = no goodreads_poll job and `tools.sync --source goodreads` says so.
GOODREADS_RSS_URL=
ANTHROPIC_API_KEY=
SUMMARY_MONTHLY_CAP_USD=3
